# Copiar a .env y completar valores reales.
MONGO_URI=mongodb://127.0.0.1:27017/volta
PORT=3000
JWT_SECRET=cambia_este_secreto_por_uno_largo

# Gmail SMTP (recuperación de contraseña y avisos de viaje)
# EMAIL_PASS = contraseña de aplicación de Google (16 caracteres), no la de la cuenta.
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Orígenes extra de CORS (coma). voltabs.mx, localhost y LAN ya están permitidos.
# CORS_ORIGINS=https://otro-dominio.com

# Push web (opcional). Si faltan, se generan en backend/data/vapid.json
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=

# App / Universal Links (opcional; para verificar en tiendas)
# APPLE_TEAM_ID=XXXXXXXXXX
# ANDROID_CERT_SHA256=AA:BB:...
