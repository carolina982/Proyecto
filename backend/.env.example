# Copiar a .env y completar valores reales.
MONGO_URI=mongodb://127.0.0.1:27017/volta
PORT=3000
JWT_SECRET=cambia_este_secreto

# --- Correo recuperación de contraseña (elige UNA opción) ---

# Opción A — Resend (producción)
# 1) https://resend.com  → Domains → verificar voltabs.mx (o tu dominio)
# 2) API Key + from del dominio verificado:
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Volta App <noreply@voltabs.mx>

# Opción B — Gmail SMTP (envía a cualquier destinatario)
# Si EMAIL_USER y EMAIL_PASS están, se usa Gmail y no Resend.
# EMAIL_USER=tu_correo@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
